{
  "expo": {
    "name": "My Telecom",
    "slug": "mytelecom",
    "version": "1.0.0",
    "scheme": "mytelecom",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-asset",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-logo.png",
          "imageWidth": 200,
          "backgroundColor": "#101112",
          "resizeMode": "contain"
        }
      ],
      "expo-notifications"
    ],
    "ios": {
      "bundleIdentifier": "iq.com.mytelecom.app",
      "supportsTablet": true,
      "buildNumber": "1"
    },
    "android": {
      "package": "iq.com.mytelecom.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "googleServicesFile": "./google-services.json"
    },
    "experiments": {
      "typedRoutes": false
    }
  }
}
